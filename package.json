{
  "name": "webapps-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "build:pages": "vite build --mode pages --base ./ --outDir docs --emptyOutDir false"
  },
  "dependencies": {
    "express": "^5.3.0",
    "html2canvas": "^1.4.1",
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^6.3.5"
  }
}
